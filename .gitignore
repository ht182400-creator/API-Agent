# ==============================================================================
# 仓库根 .gitignore
# ------------------------------------------------------------------------------
# ⚠️ 本仓库为**公开（public）**仓库，以下内容一律不得提交。
#    子目录另有 api-platform/.gitignore 与 api-platform/web/.gitignore。
#    新增规则时请同步更新 api-platform/docs/OPTIMIZATION_BACKLOG.md 的记录。
# ==============================================================================

# ── 密钥与凭据（公开仓库严禁提交）─────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
.env
.env.*
!.env.example
keys/
**/keys/

# ── 数据库文件 ────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# ── AI 工作记忆（内部记录，不公开）────────────────────────────────────────────
# 说明：.codebuddy/ 存放跨会话记忆与每日工作日志，属内部过程记录，
#       且可能含环境细节，**不提交到公开仓库**。
.codebuddy/

# ── 依赖与构建产物 ────────────────────────────────────────────────────────────
node_modules/
dist/
build/
out/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/
.venv/
venv/

# ── 运行时 / 日志 / 临时文件 ──────────────────────────────────────────────────
*.log
logs/
*.tmp
*.bak
*~
Thumbs.db
Desktop.ini
.DS_Store

# ── 测试产物 ──────────────────────────────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/

# ── 编辑器 / IDE ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
