# ==============================================================================
# API Platform 环境变量配置模板
# ------------------------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 .env ：  copy .env.example .env      (Windows)
#                          cp .env.example .env        (Linux/macOS)
#   2. 按当前环境修改各项取值
#   3. .env 存放真实密钥，禁止提交到版本库（已在 .gitignore 中排除）
#
# 取值优先级：环境变量  >  .env 文件  >  代码默认值
# 配置加载：src/config/settings.py (pydantic-settings, env_file=".env")
#
# ⚠️ 生产环境安全校验（fail-fast）
#   当 ENVIRONMENT=production 时，服务启动会执行 settings.validate_for_production()，
#   若下列任一项未满足，将直接抛出 RuntimeError 拒绝启动：
#     - PAYMENT_MOCK_MODE 必须为 false
#     - ALIPAY_SANDBOX 必须为 false
#     - DEBUG 建议为 false
#     - JWT_SECRET_KEY / SECRET_KEY / API_KEY_ENCRYPTION_SECRET 必须更换默认值
#     - DATABASE_URL / REDIS_URL 必须更换默认值
#   详见 docs/ENVIRONMENT_AND_PAYMENT_MODE.md
# ==============================================================================


# ==============================================================================
# 一、运行环境
# ------------------------------------------------------------------------------
# 作用：标识服务运行环境，影响安全校验、CORS 放行、账单环境标识等。
# 可选值：
#   development —— 开发环境（默认）。允许模拟支付，CORS 放行所有 localhost 端口
#   staging     —— 预发/联调环境。允许模拟支付，作为"模拟测试的正式试验场"
#   test        —— 测试环境（pytest 等自动化测试使用）
#   production  —— 生产环境。启用启动强校验，禁止模拟支付与沙箱
# 是否生产必须修改：必须显式设为 production
# ==============================================================================
ENVIRONMENT=development


# ==============================================================================
# 二、应用基础配置
# ------------------------------------------------------------------------------
# API_V1_PREFIX —— 所有业务接口的统一前缀（默认 /api/v1），一般无需修改
# DEBUG         —— 调试开关。true=开启 /docs、/redoc 且有详细错误堆栈；
#                  生产环境应为 false（否则校验不通过）
# ==============================================================================
API_V1_PREFIX=/api/v1
DEBUG=true


# ==============================================================================
# 三、日志配置
# ------------------------------------------------------------------------------
# ── 3.1 生效项 ────────────────────────────────────────────────────────────────
# LOG_LEVEL —— 日志级别，被 src/main.py 的 setup_logger() 读取，真实生效。
#   可选值（不区分大小写）：DEBUG / INFO / WARNING / ERROR / CRITICAL
#     DEBUG    —— 记录所有日志（开发环境推荐）
#     INFO     —— 记录一般信息（测试/生产推荐）
#     WARNING  —— 仅警告与错误（生产精简推荐）
#     ERROR    —— 仅错误
#     CRITICAL —— 仅严重错误
#   日志输出位置：
#     主日志   logs/server_api_platform_YYYYMMDD.log
#     模块日志 logs/modules/<模块名>_YYYYMMDD.log
#     备份目录 logs/backups/
#
# ── 3.2 预留项（⚠️ 当前版本代码尚未接入，改这里不会生效）─────────────────────
# 以下变量为历史配置模板保留。日志文件路径、控制台开关、轮转方式、备份参数
# 目前由后端 LogConfig / LogBackupManager 内部管理，调整方式见每项说明。
# 保留它们是为了后续"日志配置统一外置化"改造时的占位。
#
# LOG_FILE                —— 日志文件路径。当前实际路径由代码常量 LOG_DIR 决定
# LOG_ENABLE_CONSOLE      —— 是否输出到控制台。当前由 setup_logger(enable_console=) 决定
# LOG_ENABLE_FILE         —— 是否输出到文件。当前由 setup_logger(enable_file=) 决定
# LOG_ROTATION            —— 轮转方式（size 按大小 / time 按时间）。当前由代码参数决定
# LOG_BACKUP_MAX_SIZE_MB  —— 单文件最大 MB。当前由 LogBackupManager 配置决定（默认 10）
# LOG_BACKUP_MAX_FILES    —— 最大备份数。当前由 LogBackupManager 配置决定（默认 100）
# LOG_BACKUP_AUTO_CLEANUP —— 是否自动清理旧备份。当前由 LogBackupManager 决定（默认 true）
# LOG_BACKUP_CLEANUP_THRESHOLD —— 清理阈值(%)。当前由 LogBackupManager 决定（默认 80）
# LOG_BACKUP_ENABLED      —— 是否启用自动备份。当前由 LogBackupManager 决定（默认 true）
#
# 如需调整备份参数，请使用日志管理接口（管理员）：
#   PUT /api/v1/admin/logs/config      查询/更新备份配置
#   POST /api/v1/admin/logs/backup/{module}   手工触发备份
# ==============================================================================
LOG_LEVEL=DEBUG

# --- 预留项（未接入代码，仅占位）---
# LOG_FILE=logs/api_platform.log
# LOG_ENABLE_CONSOLE=true
# LOG_ENABLE_FILE=true
# LOG_ROTATION=size
# LOG_BACKUP_MAX_SIZE_MB=10
# LOG_BACKUP_MAX_FILES=100
# LOG_BACKUP_AUTO_CLEANUP=true
# LOG_BACKUP_CLEANUP_THRESHOLD=80
# LOG_BACKUP_ENABLED=true


# ==============================================================================
# 四、数据库配置（★ 分库）
# ------------------------------------------------------------------------------
# ── 4.1 分库约定（重要）───────────────────────────────────────────────────────
# 不同环境必须使用**独立数据库**，禁止共用同一库：
#     development / staging  ->  api_platform_dev
#     自动化测试（pytest）    ->  api_platform_test
#     production             ->  api_platform_prod（真实生产库位于服务器，本地同名库仅作模拟）
#
# 为什么要分库：
#     "生产与测试共用一库、仅靠 environment 字段隔离"是资金类系统的**高危形态** ——
#     一次配置写错就可能在生产库上跑测试，或把测试数据写进生产库。
#
# 启动护栏（fail-fast，见 src/config/settings.py::validate_database_separation）：
#     - 生产环境禁止连接疑似开发/测试库（库名含 dev / test / staging / local）
#     - 非生产环境禁止连接疑似生产库（库名含 prod）
#
# 豁免开关（危险，仅限确需连接生产库排查的场景）：
#     ALLOW_PRODUCTION_DATABASE=true
#
# ── 4.2 连接项 ────────────────────────────────────────────────────────────────
# DATABASE_URL          —— PostgreSQL 异步连接串（必须带 +asyncpg 驱动）
#                          格式：postgresql+asyncpg://用户名:密码@主机:端口/库名
#                          同步驱动（迁移脚本用）会自动推导
# DATABASE_POOL_SIZE    —— 连接池常驻连接数
# DATABASE_MAX_OVERFLOW —— 连接池溢出上限（高并发时可临时超出）
# 是否生产必须修改：是（替换默认用户名/密码，并指向 api_platform_prod）
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://api_user:api_password@localhost:5432/api_platform_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# 非生产环境连接生产库的豁免开关（默认 false = 禁止）
# ALLOW_PRODUCTION_DATABASE=false


# ==============================================================================
# 五、Redis 与缓存配置
# ------------------------------------------------------------------------------
# ── 5.1 Redis 连接 ────────────────────────────────────────────────────────────
# REDIS_URL             —— Redis 连接串；带密码时格式 redis://:密码@主机:端口/库号
# REDIS_MAX_CONNECTIONS —— 连接池最大连接数
# 用途：限流计数（P0-3）、热点数据缓存（P1-5）
# 是否生产必须修改：是（替换默认密码）
#
# ── 5.2 缓存 ──────────────────────────────────────────────────────────────────
# CACHE_ENABLED     —— 缓存总开关
#                      Redis 不可用时会自动降级为"不缓存"（不影响接口可用性）
# CACHE_DEFAULT_TTL —— 默认缓存过期时间（秒），各业务可单独指定
# CACHE_KEY_PREFIX  —— 缓存 key 全局前缀，便于区分环境与批量失效
#                      （例如多环境共用同一 Redis 时，务必设置不同前缀）
#
# ⚠️ 注意：系统配置（system_configs）包含支付宝私钥等敏感值，
#          当前**刻意不做缓存**，避免密钥被复制到 Redis。
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

CACHE_ENABLED=true
CACHE_DEFAULT_TTL=60
CACHE_KEY_PREFIX=cache

# ── 5.3 就绪探针 ──────────────────────────────────────────────────────────────
# READY_REQUIRE_REDIS —— /ready 探针是否把 Redis 视为**强依赖**
#     false（默认）—— Redis 不可用不影响就绪。因为平台对 Redis 已做优雅降级
#                     （限流回落数据库计数、缓存自动跳过），
#                     不应因 Redis 抖动导致实例被容器编排摘除。
#     true          —— Redis 不可用即判定未就绪（适用于 Redis 为硬依赖的定制部署）。
#
# 说明：/health 为**存活**探针（仅表示进程在运行，不校验依赖）；
#       /ready 为**就绪**探针（校验依赖，不可用返回 503）。
# ==============================================================================
READY_REQUIRE_REDIS=false


# ==============================================================================
# 六、安全密钥（生产环境必须全部更换）
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY            —— 用户登录 JWT 的签名密钥
#                              生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_ALGORITHM             —— JWT 签名算法，固定 HS256，一般不改
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES —— 访问令牌有效期（分钟），默认 30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS   —— 刷新令牌有效期（天），默认 7
# SECRET_KEY                —— 应用级通用签名/加密密钥（如会话、验签）
# ENCRYPTION_KEY            —— 通用对称加密密钥（32 字节）
# API_KEY_ENCRYPTION_SECRET —— 用于加密存储 API Key 明文，支撑"查看 API Key"功能
#                              若更换，已加密的历史 Key 将无法解密，需重新生成
#                              生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 是否生产必须修改：是（全部）
# ==============================================================================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

SECRET_KEY=your-application-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-bytes
API_KEY_ENCRYPTION_SECRET=your-api-key-encryption-secret-change-in-production


# ==============================================================================
# 七、密码哈希模式
# ------------------------------------------------------------------------------
# PASSWORD_HASH_MODE —— 用户密码哈希算法
#   bcrypt —— 推荐，安全性高（默认生产使用）
#   sha256 —— 更快，兼容历史存量数据
#   auto   —— 自动兼容两种（存在 bcrypt 用 bcrypt，否则用 sha256），推荐过渡期
# 是否生产必须修改：否（默认 auto 即可）
# ==============================================================================
PASSWORD_HASH_MODE=auto


# ==============================================================================
# 八、CORS 跨域配置
# ------------------------------------------------------------------------------
# CORS_ORIGINS            —— 允许跨域的前端源，多个用英文逗号分隔，不要带结尾斜杠
# CORS_ALLOW_ALL_LOCALHOST —— 是否自动放行所有 localhost 端口（3000-9999）
#                            仅在 ENVIRONMENT=development 时生效
# 是否生产必须修改：是（改为正式域名，并建议设 CORS_ALLOW_ALL_LOCALHOST=false）
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_ALL_LOCALHOST=true


# ==============================================================================
# 九、限流配置
# ------------------------------------------------------------------------------
# ── 9.1 总开关 ────────────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED    —— 限流总开关（关闭后 API Key 与 IP 维度均不再限制）
# RATE_LIMIT_PER_MINUTE —— 默认每分钟请求上限（保留字段，供默认策略使用）
#
# ── 9.2 限流后端 ──────────────────────────────────────────────────────────────
# RATE_LIMIT_BACKEND —— 计数存储后端
#     redis    —— 推荐。Redis 固定窗口计数（Lua 原子 INCR+EXPIRE），
#                 Redis 不可用时**自动回落数据库计数**，保证不失能；
#     memory   —— 进程内计数，仅单实例有效（多实例下实际限额会被放大）；
#     database —— 强制走数据库计数（旧行为，仅用于排障/灰度回退，性能差）。
#
# RATE_LIMIT_REDIS_PREFIX —— Redis 计数 key 前缀（多环境共用 Redis 时区分）
#
# ── 9.3 IP 维度限流（防刷）───────────────────────────────────────────────────
# RATE_LIMIT_IP_ENABLED    —— 是否在中间件层按客户端 IP 限流
#     默认 false：避免误伤前端 SPA 的高频并发请求。
#     生产环境建议开启，并按实际流量调大阈值。
# RATE_LIMIT_IP_PER_MINUTE —— 单 IP 每分钟上限（仅在上一项为 true 时生效）
#
# RATE_LIMIT_EXEMPT_PATHS  —— 免限流路径（前缀匹配，逗号分隔）
#     健康检查、API 文档、支付渠道回调等不应被限流。
#
# 说明：API Key 维度的 RPM/RPH 由 RATE_LIMIT_BACKEND 决定存储位置；
#       限流触发时返回 HTTP 429（业务码 42901）并带上
#       X-RateLimit-Limit / X-RateLimit-Remaining / X-RateLimit-Reset / Retry-After。
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_PREFIX=rl

RATE_LIMIT_IP_ENABLED=false
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_EXEMPT_PATHS=/health,/ready,/docs,/redoc,/openapi.json,/api/v1/payments/alipay/callback


# ==============================================================================
# 十、仓库出站地址安全（SSRF 防护）
# ------------------------------------------------------------------------------
# ALLOW_PRIVATE_REPO_ENDPOINTS —— 是否允许"仓库后端地址"指向内网 / 环回地址。
#
#   背景：平台会根据仓库配置的 endpoint_url 发起服务端出站请求（仓库转发）。
#         若地址可任意填写，攻击者可指向内网服务或云元数据地址窃取敏感信息。
#
#   可选值：
#     留空（不配置，推荐）—— 自动：非生产环境允许，生产环境禁止
#     false              —— 始终禁止（最严格，推荐生产）
#     true               —— 始终允许（生产环境存在 SSRF 风险，仅限临时排查）
#
#   注意：无论该值如何，以下始终被阻断：
#     - 非 http/https 协议（file://、gopher://、dict:// 等）
#     - 云厂商元数据地址（169.254.169.254、100.100.100.200、fd00:ec2::254）
#     - *.localhost 主机名
#
#   本地调试提示：OwnerServer 的示例 weather-api 运行在 http://localhost:8001，
#   非生产环境默认允许，无需修改本项。
# ==============================================================================
# ALLOW_PRIVATE_REPO_ENDPOINTS=


# ==============================================================================
# 十一、支付模式（核心开关）
# ------------------------------------------------------------------------------
# PAYMENT_MOCK_MODE —— 支付模拟模式开关
#   true  —— 模拟支付：允许 POST /api/v1/payments/callback 直接补账（仅测试/联调）
#   false —— 真实支付：通用模拟回调接口下线（返回 404），真实链路走支付宝回调
#
# ⚠️ 账单 environment 字段**不再由本开关决定**（V1.1 起已解耦）：
#   账单环境由 ENVIRONMENT 决定：
#     ENVIRONMENT=production/prod  -> production
#     其余（development / staging）-> simulation
#   原因：关闭 mock 只表示"不放行模拟回调"，并不代表本地账单属于生产数据；
#         否则本地联调真实沙箱时会污染生产账单口径。
#   详见 docs/ENVIRONMENT_AND_PAYMENT_MODE.md §6.1
#
# ⚠️ 生产环境必须为 false，否则服务拒绝启动。
# ⚠️ 模拟测试请在 development/staging 环境进行。
#
# INTERNAL_API_TOKEN —— 非生产环境下调用模拟回调接口所需的内部令牌
#   用途：自动化脚本/CI 无需登录即可触发模拟回调
#   用法：请求头 X-Internal-Token: <该值>
#   留空则只能通过"已登录用户 JWT"触发模拟回调
#   生产环境该项无效（该接口已下线）
# ==============================================================================
PAYMENT_MOCK_MODE=true
INTERNAL_API_TOKEN=


# ==============================================================================
# 十二、支付宝配置
# ------------------------------------------------------------------------------
# ALIPAY_SANDBOX    —— 是否使用沙箱网关。true=沙箱（测试），false=生产
#                      ⚠️ 生产环境必须为 false
# ALIPAY_APP_ID     —— 支付宝应用 AppID
#                      沙箱获取：https://open.alipay.com/develop/sandbox/app
# ALIPAY_PRIVATE_KEY      —— 应用私钥内容（内联，PKCS1 格式，-----BEGIN RSA PRIVATE KEY-----）
# ALIPAY_PRIVATE_KEY_FILE —— 应用私钥文件路径（推荐用文件方式，避免长文本入库）
#                           注意：alipay-sdk-python 要求 PKCS1 格式
#                           生成：openssl genrsa -out app_private_key.pem 2048
#                                 openssl rsa -in app_private_key.pem -traditional -out app_private_key_pkcs1.pem
# ALIPAY_PUBLIC_KEY       —— 支付宝公钥内容（内联）；ALIPAY_PUBLIC_KEY_FILE 为文件路径
# ALIPAY_NOTIFY_URL —— 异步回调地址，必须公网可访问
#                      格式：https://你的域名/api/v1/payments/alipay/callback
# ALIPAY_RETURN_URL —— 同步跳转地址（支付完成后浏览器跳回）
#                      格式：https://你的域名/api/v1/payments/alipay/return
# ALIPAY_SANDBOX_GATEWAY / ALIPAY_PRODUCTION_GATEWAY —— 网关地址，一般无需修改
#
# 取值优先级：若 *_PRIVATE_KEY / *_PUBLIC_KEY 内联值非空则优先使用，否则读取 *_FILE 文件
# 是否生产必须修改：是（切换正式网关、填入正式应用与密钥）
# ==============================================================================
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=

# 方式一：内联密钥（留空则回退到文件方式）
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 方式二：密钥文件（推荐）
ALIPAY_PRIVATE_KEY_FILE=keys/alipay_private_key_pkcs1.pem
ALIPAY_PUBLIC_KEY_FILE=keys/alipay_public_key.pem

# 回调与跳转地址（开发测试可用 ngrok / cloudflared 内网穿透）
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=http://localhost:3000/recharge

# 网关地址
ALIPAY_SANDBOX_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_PRODUCTION_GATEWAY=https://openapi.alipay.com/gateway.do


# ==============================================================================
# 十三、前端地址（用于支付宝 return_url 跳转）
# ------------------------------------------------------------------------------
# FRONTEND_BASE_URL —— 前端页面可被外网访问的地址。
#   背景：支付宝从服务器端跳回 RETURN_URL 后，后端会 302 重定向到前端页面，
#         若前端只在 localhost，外网/隧道场景下浏览器可能无法访问。
#   取值：
#     本地开发 —— http://localhost:3000
#     内网穿透 —— cloudflared 生成的 https://xxxx.trycloudflare.com（每次重启会变，需更新）
#     线上     —— https://你的正式域名
# 是否生产必须修改：是（填正式域名）
# ==============================================================================
FRONTEND_BASE_URL=http://localhost:3000


# ==============================================================================
# 十四、充值配置
# ------------------------------------------------------------------------------
# RECHARGE_MIN_AMOUNT          —— 单次最小充值金额（元）
# RECHARGE_MAX_AMOUNT          —— 单次最大充值金额（元）
# RECHARGE_DEFAULT_BONUS_RATIO —— 默认赠送比例（0.1 = 充值 100 送 10）
# ==============================================================================
RECHARGE_MIN_AMOUNT=1.0
RECHARGE_MAX_AMOUNT=10000.0
RECHARGE_DEFAULT_BONUS_RATIO=0.0


# ==============================================================================
# 十五、试用/体验金配置
# ------------------------------------------------------------------------------
# TRIAL_AMOUNT        —— 新用户试用金额（元）
# TRIAL_ENABLED       —— 是否启用试用功能
# TRIAL_ONE_TIME_ONLY —— 是否仅能领取一次
# 说明：试用金订单的 environment 同样遵循当前支付模式（simulation/production）
# ==============================================================================
TRIAL_AMOUNT=20.0
TRIAL_ENABLED=true
TRIAL_ONE_TIME_ONLY=true


# ==============================================================================
# 十六、默认计费规则
# ------------------------------------------------------------------------------
# 说明：当某个仓库未单独配置 RepoPricing 时，回退使用以下默认计费规则。
# BILLING_DEFAULT_ENABLED          —— 是否启用默认计费（false 则未配置仓库免费）
# BILLING_DEFAULT_TYPE             —— 计费类型：per_call 按次 / token 按量 / free 免费
# BILLING_DEFAULT_PRICE_PER_CALL   —— 按次单价（元/次）
# BILLING_DEFAULT_PRICE_PER_TOKEN  —— 按 Token 单价（元/Token）
# BILLING_DEFAULT_FREE_CALLS       —— 每个 API Key 的免费调用次数
# BILLING_DEFAULT_FREE_TOKENS      —— 每个 API Key 的免费 Token 数
# ==============================================================================
BILLING_DEFAULT_ENABLED=true
BILLING_DEFAULT_TYPE=per_call
BILLING_DEFAULT_PRICE_PER_CALL=0.01
BILLING_DEFAULT_PRICE_PER_TOKEN=0.0001
BILLING_DEFAULT_FREE_CALLS=0
BILLING_DEFAULT_FREE_TOKENS=0


# ==============================================================================
# 十七、测试环境专用（仅自动化测试使用，常规运行无需填写）
# ------------------------------------------------------------------------------
# TEST_DATABASE_URL —— pytest 使用的测试数据库连接串（tests/conftest.py 读取）
#
#   ⚠️ 必须指向**专用测试库**！
#      测试会在每个用例结束后 DROP 所有表，若指向开发/生产库将造成**数据清空**。
#      conftest.py 已内置安全护栏：库名不含 "test" 时直接拒绝运行。
#
#   默认值：postgresql+asyncpg://api_user:api_password@localhost:5432/api_platform_test
#
#   首次使用需创建测试库：
#     $env:PGPASSWORD='postgres'
#     & "D:\Program Files\PostgreSQL\16\bin\psql.exe" -h localhost -U postgres -d postgres `
#         -c "CREATE DATABASE api_platform_test OWNER api_user;"
#
#   确需对非 test 库执行（已知风险）：ALLOW_NON_TEST_DATABASE=1
#
# 说明：运行测试前请确保 PostgreSQL 已启动。
#       python -m pytest tests/ -v
# ==============================================================================
# TEST_DATABASE_URL=postgresql+asyncpg://api_user:api_password@localhost:5432/api_platform_test
