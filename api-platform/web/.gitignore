# ============================================================
# 前端（web）忽略规则
# ------------------------------------------------------------
# 背景：node_modules 曾被误提交进版本库（约 1.7 万个文件），
#       已于 2026-09-15 通过 `git rm -r --cached` 移出索引。
#       依赖请通过 `npm install` 安装，不要提交。
# ============================================================

# 依赖目录（严禁提交）
node_modules/

# 构建产物
dist/
dist-ssr/
.vite/
*.local

# 测试产物
playwright-report/
test-results/
blob-report/
playwright/.cache/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
